{
  "name": "@aurum/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.mysql --import tsx --watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.mjs",
    "prisma:generate": "npm run build -w @aurum/identity && npm run build -w @aurum/company && prisma generate --config prisma.config.ts",
    "prebuild": "npm run prisma:generate",
    "pretypecheck": "npm run prisma:generate",
    "pretest": "npm run build",
    "prisma:deploy": "node --env-file-if-exists=../../.env.mysql ../../node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts",
    "lint": "eslint src test scripts --max-warnings 0"
  },
  "dependencies": {
    "@aurum/company": "file:../../packages/company",
    "@aurum/identity": "file:../../packages/identity",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/cqrs": "^12.1.3",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@aurum/access": "file:../../packages/access"
  }
}
