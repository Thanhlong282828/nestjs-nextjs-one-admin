generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("companies")
}
