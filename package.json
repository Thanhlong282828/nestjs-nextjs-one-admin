{
  "name": "aurum-erp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w @aurum/admin",
    "dev:khach": "npm run dev -w @aurum/khach",
    "dev:api": "npm run dev -w @aurum/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p packages/ui-glass/tsconfig.json",
    "test": "npm run test --workspaces --if-present && npm run test:glass",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:seed:development": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/seed-development.mjs",
    "db:seed:module": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/seed-development.mjs",
    "db:status": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-status-cli.ts",
    "db:health": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-inspect.mjs health",
    "db:verify": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-verify-cli.ts",
    "lint": "eslint apps/admin apps/khach apps/api packages scripts --max-warnings 0",
    "test:architecture": "node --test scripts/architecture.test.mjs && node scripts/check-architecture.mjs",
    "test:glass": "TSX_TSCONFIG_PATH=packages/ui-glass/tsconfig.json node --import tsx --test packages/ui-glass/test/*.test.tsx",
    "test:glass:browser": "node scripts/glass-browser.test.mjs",
    "test:hrm:browser": "node scripts/hrm-browser-e2e.cjs",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:i18n:coverage": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "test:typescript-policy": "tsc -p scripts/typescript-policy/tsconfig.json && node --import tsx --test scripts/typescript-policy/check.test.ts && node --import tsx scripts/typescript-policy/run.ts",
    "test:demo-plan": "tsc -p scripts/demo-provisioning/tsconfig.json && node --import tsx --test scripts/demo-provisioning/plan.test.ts",
    "test:hrm:provisioned-browser": "node --import tsx scripts/hrm-provisioned-browser-e2e.cjs",
    "test:runtime-privileges": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json node --import tsx --test apps/api/test/security/runtime-privileges.test.ts",
    "db:report": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-report-cli.ts",
    "test:hrm:application-demo-browser": "node --import tsx scripts/hrm-application-demo-browser-e2e.cjs",
    "db:migrate": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-migrate-cli.ts",
    "db:permissions": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/runtime-permission-cli.ts",
    "db:provision": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-provision-cli.ts",
    "db:backup": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-backup-cli.ts",
    "db:restore-check": "node --env-file-if-exists=.env.mysql --import tsx apps/api/scripts/database-restore-check-cli.ts"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": "10.9.4"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
